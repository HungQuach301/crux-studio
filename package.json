{
  "name": "crux-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "contracts": "node ops/scripts/check-contracts.ts",
    "lint:deps": "node ops/scripts/lint-deps.ts",
    "lint:workflows": "node ops/scripts/check-workflows.ts",
    "check:tests": "node ops/scripts/check-test-coverage.ts",
    "check:workflows-synced": "node ops/scripts/check-workflows-synced.ts",
    "assumptions": "node ops/scripts/check-assumptions.ts",
    "recheck:assumptions": "node ops/scripts/recheck-assumptions.ts",
    "backlog:status": "node ops/scripts/backlog-status.ts",
    "lanes:heartbeat": "node ops/scripts/lane-heartbeat.ts",
    "digest:metrics": "node ops/scripts/digest-metrics.ts",
    "gate:flow": "node ops/scripts/gate-flow.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"kernel/test/**/*.test.ts\" \"workshops/**/test/**/*.test.ts\" \"ops/test/**/*.test.ts\" \"spike/**/test/**/*.test.ts\"",
    "replay": "node ops/scripts/replay.ts",
    "run:episode": "node ops/scripts/run-episode.ts",
    "run:workshop": "node ops/scripts/run-workshop.ts",
    "check": "pnpm contracts && pnpm lint:deps && pnpm lint:workflows && pnpm check:tests && pnpm assumptions && pnpm typecheck && pnpm test && pnpm replay"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "5.9.3"
  }
}
