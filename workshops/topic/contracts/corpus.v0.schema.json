{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crux.studio/contracts/topic/corpus.v0.schema.json",
  "title": "Ảnh chụp corpus đối thủ — v0",
  "description": "Corpus là METADATA, không phải nội dung. Ba giới hạn của WP-014 mục 3c được mã hoá thành trường bắt buộc ở đây, không nằm trong ghi chú: coverage.contentLevel khoá 'metadata-only'; quota.limits.source nói rõ số hạn mức đọc từ đâu; coverage.partialReason bắt buộc có chữ khi corpus chỉ chụp được một phần.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "builtAt", "provenance", "scope", "queries", "coverage", "quota", "videos"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 0 },
    "corpusId": { "type": "string", "minLength": 1 },
    "builtAt": { "type": "string", "format": "date-time" },
    "provenance": {
      "enum": ["hand-built", "api"],
      "description": "Corpus này thu từ API nền tảng, hay dựng bằng tay để có dữ liệu chạy khi chưa có khoá? Cùng luật với `quota.limits.source`: đây là giới hạn LỚN NHẤT của một file corpus, nên nó phải đi theo file, không nằm trong README mà bên đọc có thể chưa từng mở."
    },
    "scope": { "$ref": "#/definitions/scope" },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "pagesFetched", "resultsKept"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "pagesFetched": { "type": "integer", "minimum": 1 },
          "resultsKept": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentLevel", "videoCount", "partial", "partialReason"],
      "properties": {
        "contentLevel": {
          "const": "metadata-only",
          "description": "WP-014 mục 3c.1: API không cho tải phụ đề video của người khác. Trường này khoá cứng để không nơi nào trong hệ thống tưởng corpus có nội dung."
        },
        "videoCount": { "type": "integer", "minimum": 0 },
        "partial": { "type": "boolean" },
        "partialReason": {
          "type": ["string", "null"],
          "description": "Bắt buộc có chữ khi partial = true (kiểm ở corpusProblems, không kiểm được bằng schema)."
        }
      }
    },
    "quota": { "$ref": "#/definitions/quota" },
    "videos": {
      "type": "array",
      "items": { "$ref": "#/definitions/video" }
    }
  },
  "definitions": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions", "languages", "windowDays", "asOf"],
      "properties": {
        "regions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
        "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "windowDays": { "type": "integer", "minimum": 1 },
        "asOf": { "type": "string", "format": "date-time" }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits", "spent"],
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["searchCallsPerDay", "reserveFraction", "source", "checkedAt"],
          "properties": {
            "searchCallsPerDay": { "type": "integer", "minimum": 1 },
            "reserveFraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "WP-014 mục 5: dừng khi còn ngần này phần bucket tìm kiếm, để dành cho việc khác."
            },
            "source": {
              "enum": ["vendor-docs", "console-measured"],
              "description": "WP-014 mục 7 đòi số ĐỌC TỪ Cloud Console. Tới khi có người đọc, giá trị trung thực là 'vendor-docs' — con số vẫn dùng được, nhưng mọi bên tiêu thụ thấy ngay nó chưa được đo."
            },
            "checkedAt": { "type": "string", "format": "date-time" }
          }
        },
        "spent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["searchCalls"],
          "properties": {
            "searchCalls": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoId", "title", "publishedAt", "durationMs", "viewCount", "channelId"],
      "properties": {
        "videoId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "viewCount": { "type": "integer", "minimum": 0 },
        "channelId": { "type": "string", "minLength": 1 },
        "channelTitle": { "type": "string" }
      }
    }
  }
}
