{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "crux://contracts/audio.payload.v0.schema.json",
  "title": "Xưởng Âm thanh — payload v0",
  "description": "Gợi ý lấy từ timing.schema.json của spec tham chiếu. File nhị phân KHÔNG commit (CHARTER 5.3): các trường *Ref là con trỏ tới Actions artifact hoặc Releases.",
  "type": "object",
  "required": ["audioRef", "captionsRef", "totalMs", "loudnessLufs", "words", "voice"],
  "properties": {
    "audioRef": { "type": "string", "minLength": 1 },
    "captionsRef": { "type": "string", "minLength": 1 },
    "totalMs": { "type": "integer", "minimum": 1000 },
    "loudnessLufs": { "type": "number" },
    "captionDriftMaxMs": { "type": "integer", "minimum": 0 },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "startMs", "endMs"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "voice": {
      "type": "object",
      "required": ["provider", "voiceId", "commercialLicenseVerified"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "voiceId": { "type": "string", "minLength": 1 },
        "commercialLicenseVerified": {
          "type": "boolean",
          "description": "Giả định G7. Mỗi giọng đọc dùng thật phải có một dòng trong ops/license-ledger.md."
        }
      }
    }
  }
}
