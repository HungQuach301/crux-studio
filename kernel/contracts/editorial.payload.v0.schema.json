{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "crux://contracts/editorial.payload.v0.schema.json",
  "title": "Xưởng Biên tập — payload v0",
  "description": "Gợi ý lấy từ outline.schema.json và script.schema.json của spec tham chiếu.",
  "type": "object",
  "required": ["outline", "script", "selfCheck"],
  "properties": {
    "outline": {
      "type": "object",
      "required": ["beats", "adBreaks"],
      "properties": {
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["index", "name", "purpose", "estimatedMs", "curiosityBridge"],
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "estimatedMs": { "type": "integer", "minimum": 1000 },
              "claimIds": { "type": "array", "items": { "type": "string" } },
              "curiosityBridge": {
                "type": "string",
                "minLength": 10,
                "description": "Câu cuối beat khiến người xem muốn xem beat sau. Bắt buộc ở mọi ranh giới."
              }
            }
          }
        },
        "adBreaks": {
          "type": "array",
          "description": "Sinh TỪ vị trí cầu tò mò, không đặt tuỳ ý.",
          "items": {
            "type": "object",
            "required": ["atMs", "derivedFromBeat"],
            "properties": {
              "atMs": { "type": "integer", "minimum": 0 },
              "derivedFromBeat": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "script": {
      "type": "object",
      "required": ["wordCount", "claimIds", "geoScopeStated", "text"],
      "properties": {
        "wordCount": { "type": "integer", "minimum": 1 },
        "claimIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "geoScopeStated": {
          "type": "boolean",
          "const": true,
          "description": "Phải true: một câu trong lời thoại nêu rõ phạm vi địa lý của kết luận."
        },
        "localeReviewDone": { "type": "boolean" },
        "text": { "type": "string", "minLength": 1 },
        "devicesUsed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "selfCheck": {
      "type": "object",
      "description": "Giá trị xưởng TỰ KHAI. Preflight so với giá trị tính được; lệch ở đây nghiêm trọng hơn một check fail thường.",
      "required": ["declaredBeatCount", "declaredWordCount", "declaredBridgeCount"],
      "properties": {
        "declaredBeatCount": { "type": "integer", "minimum": 1 },
        "declaredWordCount": { "type": "integer", "minimum": 1 },
        "declaredBridgeCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
